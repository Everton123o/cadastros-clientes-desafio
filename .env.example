# Quando o container MySQL estiver rodando (docker compose up -d),
# copie este arquivo para .env para trocar do SQLite local para o MySQL:
DATABASE_URL=mysql+pymysql://dedup:dedup123@localhost:3306/dedup_clientes?charset=utf8mb4

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=dedup_clientes
MYSQL_USER=dedup
MYSQL_PASSWORD=dedup123
MYSQL_PORT=3306
